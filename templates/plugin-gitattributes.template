# --- Line endings: LF for source code ---
* text=auto eol=lf

# Source files (explicit)
*.cpp   text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.c     text eol=lf
*.cmake text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# --- Binary files: no diff, no line ending conversion ---
*.vst3      binary
*.component binary
*.app       binary
*.lv2       binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.pdf       binary

# --- Generated dirs: don't diff ---
build/**  binary
dist/**   binary
