      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(Invoke-WebRequest*)",
      "Bash(Invoke-Expression*)",
      "Bash(iex *)",
      "Bash(*| bash*)",
      "Bash(*| sh*)",
      "Bash(*~/.ssh*)",
      "Bash(*~/.aws*)",
      "Bash(*base64 -d*)",
      "Bash(node -e:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)"
    ]
  }
}
